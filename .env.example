# ros2_dashboard configuration -- copy to .env and edit. Never commit .env.
# Everything here is read from the process environment (twelve-factor).

# --- identity ---------------------------------------------------------------
APP_ENV=development
# Required when APP_ENV=production; the app refuses to start without it.
SECRET_KEY=change-me-in-production

# --- HTTP -------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
DEBUG=false
MAX_CONTENT_LENGTH=8388608

# --- storage ----------------------------------------------------------------
# Leave empty to use the bundled sqlite database under var/instance.
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/ros2_dashboard
DATA_DIR=
INSTANCE_DIR=
LOG_DIR=

# --- observability ----------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true
REQUEST_ID_HEADER=X-Request-ID

# --- application-specific ---------------------------------------------------
    'ANALYTICS_SALT',
    'PORT',
    'ROS2DASH_OUTPUT_DIR',
    'ROS2DASH_SECRET',
    'ROSBRIDGE_ID',
    'ROSBRIDGE_RELAY_LISTEN',
    'ROSBRIDGE_URL',

# --- application-specific ---------------------------------------------------
# rosbridge WebSocket the dashboard subscribes to.
ROSBRIDGE_URL=ws://127.0.0.1:9090
# Address the dashboard's own /ws relay binds.
ROSBRIDGE_RELAY_LISTEN=127.0.0.1:9091
# Client id sent to rosbridge.
ROSBRIDGE_ID=ros2scope
# Where recorded topic files are written; defaults under the data dir.
ROS2DASH_OUTPUT_DIR=
# Flask session key.
ROS2DASH_SECRET=
